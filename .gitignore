# macOS and IDE files
.DS_Store
**/.DS_Store
.idea/
**/__MACOSX/
**/__pycache__/
*.py[cod]
/tmp/

# Local backups and database exports
.local-backup/
*.sql
*.sql.gz
*.zip
!/database/migrations/
!/database/migrations/*.sql

# Environment-specific OpenCart configuration
/upload/config.php
/upload/admin/config.php
/upload/env.php

# Runtime and generated files
*.log
**/error_log
/upload/image/cache/*
!/upload/image/cache/index.html
/upload/catalog/view/theme/basel/stylesheet/generated/*.css
/upload/sitemaps/*
!/upload/sitemaps/index.html
!/upload/sitemaps/sitemap-style.xml
!/upload/sitemaps/sitemap_0_1_category.xml
!/upload/sitemaps/sitemap_0_1_information.xml
!/upload/sitemaps/sitemap_0_1_product.xml
!/upload/sitemaps/sitemap_0_3_category.xml
!/upload/sitemaps/sitemap_0_3_information.xml
!/upload/sitemaps/sitemap_0_3_product.xml
/upload/system/storage/
/storagedijana/cache/*
!/storagedijana/cache/index.html
/storagedijana/download/*
!/storagedijana/download/index.html
/storagedijana/digital_pricelist/*
/storagedijana/logs/*
!/storagedijana/logs/index.html
/storagedijana/modification/*
!/storagedijana/modification/index.html
/storagedijana/session/*
!/storagedijana/session/index.html
/storagedijana/upload/*
