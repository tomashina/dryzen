{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-shipping" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-shipping" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_rules }}</label>
            <div class="col-sm-10">
              <div class="table-responsive">
                <table id="shipping-rule" class="table table-striped table-bordered table-hover">
                  <thead>
                    <tr>
                      <td class="text-left">{{ column_geo_zone }}</td>
                      <td class="text-left"><span data-toggle="tooltip" title="{{ help_total }}">{{ column_total }}</span></td>
                      <td class="text-left">{{ column_status }}</td>
                      <td class="text-right">{{ column_action }}</td>
                    </tr>
                  </thead>
                  <tbody>
                    {% set rule_row = 0 %}
                    {% for rule in shipping_free_by_zone_rules %}
                    <tr id="shipping-rule-row-{{ rule_row }}">
                      <td class="text-left">
                        <select name="shipping_free_by_zone_rules[{{ rule_row }}][geo_zone_id]" class="form-control">
                          <option value="0"{% if rule.geo_zone_id == 0 %} selected="selected"{% endif %}>{{ text_all_zones }}</option>
                          {% for geo_zone in geo_zones %}
                          <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == rule.geo_zone_id %} selected="selected"{% endif %}>{{ geo_zone.name }}</option>
                          {% endfor %}
                        </select>
                      </td>
                      <td class="text-left">
                        <input type="text" name="shipping_free_by_zone_rules[{{ rule_row }}][total]" value="{{ rule.total }}" placeholder="0.00" class="form-control" />
                      </td>
                      <td class="text-left">
                        <select name="shipping_free_by_zone_rules[{{ rule_row }}][status]" class="form-control">
                          <option value="1"{% if rule.status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                          <option value="0"{% if not rule.status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
                        </select>
                      </td>
                      <td class="text-right">
                        <button type="button" onclick="moveRule(this, -1);" data-toggle="tooltip" title="{{ button_move_up }}" class="btn btn-default"><i class="fa fa-arrow-up"></i></button>
                        <button type="button" onclick="moveRule(this, 1);" data-toggle="tooltip" title="{{ button_move_down }}" class="btn btn-default"><i class="fa fa-arrow-down"></i></button>
                        <button type="button" onclick="$(this).tooltip('destroy'); $('#shipping-rule-row-{{ rule_row }}').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button>
                      </td>
                    </tr>
                    {% set rule_row = rule_row + 1 %}
                    {% endfor %}
                  </tbody>
                  <tfoot>
                    <tr>
                      <td colspan="3"><div class="help-block">{{ text_rules_help }}</div></td>
                      <td class="text-right"><button type="button" onclick="addRule();" data-toggle="tooltip" title="{{ button_add_rule }}" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button></td>
                    </tr>
                  </tfoot>
                </table>
              </div>
              <select id="geo-zone-options" class="hide" disabled="disabled">
                <option value="0">{{ text_all_zones }}</option>
                {% for geo_zone in geo_zones %}
                <option value="{{ geo_zone.geo_zone_id }}">{{ geo_zone.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="shipping_free_by_zone_status" id="input-status" class="form-control">
                {% if shipping_free_by_zone_status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_free_by_zone_sort_order" value="{{ shipping_free_by_zone_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
var rule_row = {{ rule_row }};

function addRule() {
  var html = '';

  html += '<tr id="shipping-rule-row-' + rule_row + '">';
  html += '  <td class="text-left"><select name="shipping_free_by_zone_rules[' + rule_row + '][geo_zone_id]" class="form-control">' + $('#geo-zone-options').html() + '</select></td>';
  html += '  <td class="text-left"><input type="text" name="shipping_free_by_zone_rules[' + rule_row + '][total]" value="0.00" placeholder="0.00" class="form-control" /></td>';
  html += '  <td class="text-left"><select name="shipping_free_by_zone_rules[' + rule_row + '][status]" class="form-control"><option value="1" selected="selected">{{ text_enabled }}</option><option value="0">{{ text_disabled }}</option></select></td>';
  html += '  <td class="text-right">';
  html += '    <button type="button" onclick="moveRule(this, -1);" data-toggle="tooltip" title="{{ button_move_up }}" class="btn btn-default"><i class="fa fa-arrow-up"></i></button> ';
  html += '    <button type="button" onclick="moveRule(this, 1);" data-toggle="tooltip" title="{{ button_move_down }}" class="btn btn-default"><i class="fa fa-arrow-down"></i></button> ';
  html += '    <button type="button" onclick="$(this).tooltip(\'destroy\'); $(\'#shipping-rule-row-' + rule_row + '\').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button>';
  html += '  </td>';
  html += '</tr>';

  $('#shipping-rule tbody').append(html);
  $('[data-toggle="tooltip"]').tooltip({container: 'body'});

  rule_row++;
}

function moveRule(button, direction) {
  var row = $(button).closest('tr');

  if (direction < 0 && row.prev().length) {
    row.insertBefore(row.prev());
  }

  if (direction > 0 && row.next().length) {
    row.insertAfter(row.next());
  }
}
//--></script>
{{ footer }}
