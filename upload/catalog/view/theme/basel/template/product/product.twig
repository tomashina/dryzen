		},
		success: function(json) {
			$('.alert-dismissible, .text-danger').remove();

			if (json['success']) {
				$('#recurring-description').html(json['success']);
			}
		}
	});
});
//--></script>

<script><!--
(function() {
	var $quantityInput = $('#input-quantity');

	if (!$quantityInput.length) {
		return;
	}

	var getMinQuantity = function() {
		var minimum = parseInt($quantityInput.attr('min'), 10);

		return isNaN(minimum) ? 1 : minimum;
	};

	var getStep = function() {
		var step = parseInt($quantityInput.attr('step'), 10);

		return isNaN(step) ? 1 : step;
	};

	var syncQuantityControls = function(shouldNormalize) {
		var minimum = getMinQuantity();
		var currentValue = parseInt($quantityInput.val(), 10);

		if (shouldNormalize && (isNaN(currentValue) || currentValue < minimum)) {
			currentValue = minimum;
			$quantityInput.val(currentValue);
			$quantityInput.trigger('change');
		}

		if (isNaN(currentValue)) {
			$('.dryzen-qty-btn-minus').prop('disabled', true);
			return;
		}

		$('.dryzen-qty-btn-minus').prop('disabled', currentValue <= minimum);
	};

	$('.dryzen-qty-btn').on('click', function() {
		var direction = $(this).data('direction');
		var currentValue = parseInt($quantityInput.val(), 10);
		var minimum = getMinQuantity();
		var step = getStep();

		if (isNaN(currentValue)) {
			currentValue = minimum;
		}

		currentValue = direction === 'up' ? currentValue + step : currentValue - step;

		if (currentValue < minimum) {
			currentValue = minimum;
		}

		$quantityInput.val(currentValue).trigger('change');
		syncQuantityControls(false);
	});

	$quantityInput.on('input', function() {
		syncQuantityControls(false);
	});

	$quantityInput.on('blur', function() {
		syncQuantityControls(true);
	});

	syncQuantityControls(true);
})();
//--></script>

<script><!--
$('#button-cart').on('click', function() {
	$.ajax({
		url: 'index.php?route=extension/basel/basel_features/add_to_cart',
		type: 'post',
		data: $('#product input[type=\'text\'], #product input[type=\'hidden\'], #product input[type=\'number\'], #product input[type=\'radio\']:checked, #product input[type=\'checkbox\']:checked, #product select, #product textarea'),
		dataType: 'json',
		beforeSend: function(json) {
			$('body').append('<span class="basel-spinner ajax-call"></span>');
		},

		success: function(json) {
			$('.alert, .text-danger').remove();
			$('.table-cell').removeClass('has-error');

			if (json.error) {
				$('.basel-spinner.ajax-call').remove();
				if (json.error.option) {
					for (i in json.error.option) {
						var element = $('#input-option' + i.replace('_', '-'));

						if (element.parent().hasClass('input-group')) {
							element.parent().after('<div class="text-danger">' + json.error.option[i] + '</div>');
						} else {
							element.after('<div class="text-danger">' + json.error.option[i] + '</div>');
						}
					}
				}

				if (json.error.recurring) {
					$('select[name=\'recurring_id\']').after('<div class="text-danger">' + json['error']['recurring'] + '</div>');
				}

				// Highlight any found errors
				$('.text-danger').parent().addClass('has-error');
			}

				if (json.success_redirect) {
					
					location = json.success_redirect;
				
				} else if (json.success) {
					
					$('.table-cell').removeClass('has-error');
					$('.alert, .popup-note, .basel-spinner.ajax-call, .text-danger').remove();
				 
					html = '<div class="popup-note">';
					html += '<div class="inner">';
					html += '<a class="popup-note-close" onclick="$(this).parent().parent().remove()">&times;</a>';
					html += '<div class="table">';
					html += '<div class="table-cell v-top img"><img src="' + json.image + '" /></div>';
					html += '<div class="table-cell v-top">' + json.success + '</div>';
					html += '</div>';
					html += '</div>';
					html += '</div>';
					$('body').append(html);
					setTimeout(function() {$('.popup-note').hide();}, 8100);
					// Need to set timeout otherwise it wont update the total
					setTimeout(function () {
					$('.cart-total-items').html( json.total_items );
					$('.cart-total-amount').html( json.total_amount );
					}, 100);

					$('#cart-content').load('index.php?route=common/cart/info #cart-content > *');
			}
		},
        error: function(xhr, ajaxOptions, thrownError) {
            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
	});
});
//--></script>

