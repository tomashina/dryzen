<div class="item single-product{% if dryzen_shop_card %} dryzen-shop-card{% endif %}">
    <div class="edge">
<div class="image">
    <a href="{{ product.href }}" aria-label="{{ product.name }}">
    {% set dryzen_placeholder = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==' %}
    {% set dryzen_thumb_src = product.thumb_small ?: product.thumb %}
    {% set dryzen_thumb_srcset = dryzen_thumb_src ~ ' 480w' ~ (product.thumb_medium ? ', ' ~ product.thumb_medium ~ ' 720w' : '') ~ ', ' ~ product.thumb ~ ' 900w' %}
    <img src="{{ dryzen_related_card ? dryzen_placeholder : dryzen_thumb_src }}" {% if dryzen_related_card %}data-src="{{ dryzen_thumb_src }}" data-srcset="{{ dryzen_thumb_srcset }}"{% else %}srcset="{{ dryzen_thumb_srcset }}"{% endif %} sizes="(max-width: 767px) calc(100vw - 40px), 25vw" width="900" height="900" alt="{{ product.name }}" title="{{ product.name }}" loading="lazy" decoding="async" />
    {% if product.thumb2 %}
    {% set dryzen_thumb2_src = product.thumb2_small ?: product.thumb2 %}
    {% set dryzen_thumb2_srcset = dryzen_thumb2_src ~ ' 480w' ~ (product.thumb2_medium ? ', ' ~ product.thumb2_medium ~ ' 720w' : '') ~ ', ' ~ product.thumb2 ~ ' 900w' %}
    <img class="thumb2" src="{{ dryzen_related_card ? dryzen_placeholder : dryzen_thumb2_src }}" {% if dryzen_related_card %}data-src="{{ dryzen_thumb2_src }}" data-srcset="{{ dryzen_thumb2_srcset }}"{% else %}srcset="{{ dryzen_thumb2_srcset }}"{% endif %} sizes="(max-width: 767px) calc(100vw - 40px), 25vw" width="900" height="900" alt="{{ product.name }}" title="{{ product.name }}" loading="lazy" decoding="async" />
    {% endif %}
    </a>
{% if product.price and product.special and salebadge_status %}
    <div class="sale-counter id{{ product.product_id }}"></div>
    <span class="badge sale_badge"><i>{{ product.sale_badge }}</i></span>
{% endif %}
{% if product.new_label %}
    <span class="badge new_badge"><i>{{ basel_text_new }}</i></span>
{% endif %}

{% if ((product.quantity < 1) and (stock_badge_status)) %}
 <span class="badge out_of_stock_badge"><i>{{ basel_text_out_of_stock }}</i></span>
    {% set button_cart = basel_text_out_of_stock %}
{% else %}
	{% set button_cart = default_button_cart %}
{% endif %}
<a class="img-overlay" href="{{ product.href }}" aria-label="{{ product.name }}"></a>

<div class="icons-wrapper">
<button type="button" class="icon is_wishlist" aria-label="{{ button_wishlist }}" data-toggle="tooltip" data-placement="{{ tooltip_align }}" data-title="{{ button_wishlist }}" onclick="wishlist.add('{{ product.product_id }}');"><span class="icon-heart" aria-hidden="true"></span></button>
<button type="button" class="icon is_compare" aria-label="{{ button_compare }}" onclick="compare.add('{{ product.product_id }}');" data-toggle="tooltip" data-placement="{{ tooltip_align }}" data-title="{{ button_compare }}"><span class="icon-refresh" aria-hidden="true"></span></button>
<button type="button" class="icon is_quickview hidden-xs" aria-label="{{ basel_button_quickview }}" onclick="quickview('{{ product.product_id }}');" data-toggle="tooltip" data-placement="{{ tooltip_align }}" data-title="{{ basel_button_quickview }}"><span class="icon-magnifier-add" aria-hidden="true"></span></button>
</div> <!-- .icons-wrapper -->
</div><!-- .image ends -->
<div class="caption">
<a class="product-name" href="{{ product.href }}">{{ product.name }}</a>

<span class="product-subtitle">{{ product.subtitle }}</span>
{% if product.rating %}      
    <div class="rating">
    <span class="rating_stars rating r{{ product.rating }}">
    <i class="fa fa-star-o"></i><i class="fa fa-star-o"></i><i class="fa fa-star-o"></i><i class="fa fa-star-o"></i><i class="fa fa-star-o"></i>
    </span>
    </div>
{% endif %}
{% if dryzen_shop_card %}
<div class="dryzen-shop-card-footer">
  {% if product.price %}
  <div class="dryzen-shop-card-price">
    {% if product.special %}
    <span class="price-old">{{ product.price }}</span><span>{{ product.special }}</span>
    {% else %}
    <span>{{ product.price }}</span>
    {% endif %}
  </div>
  {% endif %}

  <div class="dryzen-card-purchase">
    <div class="dryzen-card-qty" aria-label="Količina">
      <button type="button" data-quantity-direction="down" aria-label="Smanji količinu" disabled>-</button>
      <input class="dryzen-card-quantity" type="number" min="{{ product.minimum }}" step="1" value="{{ product.minimum }}" inputmode="numeric" aria-label="Količina proizvoda" />
      <button type="button" data-quantity-direction="up" aria-label="Povećaj količinu">+</button>
    </div>
    {% if ((product.quantity < 1) and (stock_badge_status)) %}
    <button class="dryzen-card-cart" type="button" disabled aria-label="{{ button_cart }}" title="{{ button_cart }}"><span class="global-cart" aria-hidden="true"></span></button>
    {% else %}
    <button class="dryzen-card-cart" type="button" data-product-id="{{ product.product_id }}" aria-label="{{ button_cart }}" title="{{ button_cart }}"><span class="global-cart" aria-hidden="true"></span></button>
    {% endif %}
  </div>
</div>
{% else %}
<div class="price-wrapper">
{% if product.price %}
<div class="pwrap">
<div class="price">
    {% if product.special %}
    <span class="price-old">{{ product.price }}</span><span class="price-new">{{ product.special }}</span>
    {% else %}
    <span>{{ product.price }}   </span>
    {% endif %}
    {% if product.tax %}
    <span class="price-tax">{{ text_tax }} {{ product.tax }}</span>
    {% endif %}

    
</div>


 </div>

<!-- .price -->
{% endif %}
<p class="description">{% if product.description %}{{ product.description }}{% endif %}</p>

{% if ((product.quantity < 1) and (stock_badge_status)) %}
  <a class="btn  {% if basel_list_style == '6' %}btn-contrast{% else %}btn-outline{% endif %}" ><span class="global-cart"></span> {{ button_cart }}</a>
    {% set button_cart = basel_text_out_of_stock %}
{% else %}
 <a class="btn  {% if basel_list_style == '6' %}btn-contrast{% else %}btn-outline{% endif %}" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');"><span class="global-cart"></span> {{ button_cart }}</a>
{% endif %}



<!-- .price-wrapper -->


</div>
{% endif %}

</div><!-- .caption-->
{% if product.sale_end_date and countdown_status %}
<script>
  $(function() {
	$(".sale-counter.id{{ product.product_id }}").countdown("{{ product.sale_end_date }}").on('update.countdown', function(event) {
  var $this = $(this).html(event.strftime(''
    + '<div>'
    + '%D<i>{{ basel_text_days }}</i></div><div>'
    + '%H <i>{{ basel_text_hours }}</i></div><div>'
    + '%M <i>{{ basel_text_mins }}</i></div><div>'
    + '%S <i>{{ basel_text_secs }}</i></div></div>'));
});
});
</script>
{% endif %}

   </div>
</div><!-- .single-product ends -->
