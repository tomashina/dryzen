<div class="container">
    {{ position_bottom_half }}
</div>
<div class="container">
    {{ position_bottom }}
</div>
<section class="dryzen-global-newsletter" aria-labelledby="dryzen-newsletter-title">
    <div class="container">
        <div class="dryzen-newsletter">
            <div class="dryzen-newsletter-copy">
                <h2 id="dryzen-newsletter-title">{{ text_dryzen_newsletter_title }}</h2>
                <p>{{ text_dryzen_newsletter_copy }}</p>
            </div>
            <div class="dryzen-newsletter-form">
                {{ global_newsletter_form }}
                <p class="dryzen-newsletter-note">{{ text_dryzen_newsletter_note }}</p>
            </div>
        </div>
    </div>
</section>
<section class="dryzen-prefooter-guarantee" aria-label="{{ text_footer_guarantee }}">
    <div class="container" style="display:flex;justify-content:center;text-align:center;">
        <a class="dryzen-legal-guarantee-trigger" href="{{ footer_guarantee_url }}" aria-controls="dryzen-legal-guarantee-modal">
            <i class="fa fa-shield" aria-hidden="true"></i>
            <span>{{ text_footer_guarantee }}</span>
        </a>
    </div>
</section>
<div id="footer">


    <div class="container">
        {% if footer_block_1 and footer_block_1 != '<p><br></p>' %}
            <div class="footer-top-block">
                {{ footer_block_1 }}
            </div>
        {% endif %}
        <div class="row links-holder">
            <div class="col-xs-12 col-sm-12">
                <div class="row">
                    {% if custom_links %}
                        {% for column in basel_footer_columns %}
                     <div class="footer-column col-xs-12 col-sm-3 eq_height">
                                {% if column.title %}
                                    <p class="h5">
                                        <a  role="button" data-toggle="collapse" href="#collapse{{ column.sort }}9" aria-expanded="false" aria-controls="collapse{{ column.sort }}9">
                                            {{ column.title }}  <b class="pull-right visible-xs">+</b>
                                        </a>
                                    </p>
                                {% endif %}

                                <div class="collapse in" id="collapse{{ column.sort }}9">
                                    {% if column.links is defined %}
                                        <ul class="list-unstyled">
                                            {% for link in column.links %}
                                                <li><a href="{{ link.target }}">{{ link.title }}</a></li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}

                                </div>

                            </div>
                        {% endfor %}
                        <script>
                            $(document).ready(function(){
                                if ($(window).width() <= 768) {
                                    $("#footer .footer-column .collapse").removeClass("in");
                                }
                            });
                        </script>
                    {% else %}
                        {% if informations %}
                            <div class="footer-column col-xs-6 col-sm-3 eq_height">
                                <h5>{{ text_information }}</h5>
                                <ul class="list-unstyled">
                                    {% for information in informations %}
                                        <li><a href="{{ information.href }}">{{ information.title }}</a></li>
                                    {% endfor %}
                                    <li><a href="{{ contact }}">{{ text_contact }}</a></li>
                                </ul>
                            </div>
                        {% endif %}
                        <div class="footer-column col-xs-6 col-sm-3 eq_height">
                            <h5>{{ text_extra }}</h5>
                            <ul class="list-unstyled">
                                <li><a href="{{ manufacturer }}">{{ text_manufacturer }}</a></li>
                                <li><a href="{{ voucher }}">{{ text_voucher }}</a></li>
                                <li><a href="{{ affiliate }}">{{ text_affiliate }}</a></li>
                                <li><a href="{{ special }}">{{ text_special }}</a></li>
                                <li><a href="{{ sitemap }}">{{ text_sitemap }}</a></li>
                            </ul>
                        </div>
                        <div class="footer-column col-xs-6 col-sm-3 eq_height">
                            <h5>{{ text_account }}</h5>
                            <ul class="list-unstyled">
                                <li><a href="{{ account }}">{{ text_account }}</a></li>
                                <li><a href="{{ order }}">{{ text_order }}</a></li>
                                <li><a href="{{ return }}">{{ text_return }}</a></li>
                                <li class="is_wishlist"><a href="{{ wishlist }}">{{ text_wishlist }}</a></li>
                                <li><a href="{{ newsletter }}">{{ text_newsletter }}</a></li>
                            </ul>
                        </div>
                    {% endif %}
                    <div class="footer-column col-xs-12 col-sm-3 eq_height">
                        <img class="skare-footer visible-xs" src="image/divider-footer.svg" width="215" height="15" alt="" aria-hidden="true">
                        <div class="footer-custom-wrapper">
                            {% if footer_block_title is defined %}
                                <p class="h5">{{ footer_block_title }}</p>
                            {% endif %}
                            {% if footer_block_2 and footer_block_2 != '<p><br></p>' %}
                                <div class="custom_block">{{ footer_block_2 }}</div>
                            {% endif %}
                            {% if footer_infoline_1 is defined %}
                                <p class="infoline">{{ footer_infoline_1 }}</p>
                            {% endif %}
                            {% if footer_infoline_2 is defined %}
                                <p class="infoline">{{ footer_infoline_2 }}</p>
                            {% endif %}
                            {% if footer_infoline_3 is defined %}
                                <p class="infoline">{{ footer_infoline_3 }}</p>
                            {% endif %}
                            {% if payment_img %}
                                <img class="payment_img" src="{{ payment_img }}" alt="" />
                            {% endif %}
                        </div>
                    </div>
                </div><!-- .row ends -->
            </div><!-- .col-md-8 ends -->

            <nav class="col-xs-12 text-center otp-footer-compliance-links" aria-label="{{ text_customer_information }}">
                <a href="{{ footer_withdrawal_url }}">{{ text_footer_withdrawal }}</a>
                {% if show_footer_pricelists %}<a href="{{ footer_pricelists_url }}">{{ text_footer_pricelists }}</a>{% endif %}
                <a class="dryzen-legal-guarantee-trigger" href="{{ footer_guarantee_url }}" aria-controls="dryzen-legal-guarantee-modal">{{ text_footer_guarantee }}</a>
                {% for compliance_link in compliance_links %}
                    <a href="{{ compliance_link.href }}">{{ compliance_link.title }}</a>
                {% endfor %}
                <a href="#cookie-settings" data-cookie-consent-trigger>{{ text_cookie_settings }}</a>
            </nav>

            <div class="col-xs-12 text-center cards-holder" aria-label="{{ text_accepted_payment_methods }}">
                <a href="https://www.mastercard.com/" target="_blank" rel="noopener noreferrer" aria-label="MasterCard – {{ text_opens_new_window }}">
                    <img class="cards-img" src="image/catalog/credit-cards/master-new.svg" alt="MasterCard" height="30" width="50">
                </a>
                <a href="https://www.mastercard.hr/hr-hr/consumers/find-card-products/debit-cards/maestro-debit.html" target="_blank" rel="noopener noreferrer" aria-label="Maestro – {{ text_opens_new_window }}">
                    <img class="cards-img" src="image/catalog/credit-cards/maestro-new.svg" alt="Maestro" height="30" width="50">
                </a>
                <a href="https://www.visaeurope.com" target="_blank" rel="noopener noreferrer" aria-label="Visa – {{ text_opens_new_window }}">
                    <img class="cards-img" src="image/catalog/credit-cards/visa.webp" alt="Visa" height="30" width="50">
                </a>
                <a href="https://www.dinersclub.com/" target="_blank" rel="noopener noreferrer" aria-label="Diners Club – {{ text_opens_new_window }}">
                    <img class="cards-img" src="image/catalog/credit-cards/diners.svg" alt="Diners Club" height="30" width="50">
                </a>
                <a href="https://pay.google.com/" target="_blank" rel="noopener noreferrer" aria-label="Google Pay – {{ text_opens_new_window }}">
                    <img class="cards-img" src="image/google_pay.svg" alt="Google Pay" height="30" width="50">
                </a>
                <a href="https://www.apple.com/apple-pay/" target="_blank" rel="noopener noreferrer" aria-label="Apple Pay – {{ text_opens_new_window }}">
                    <img class="cards-img" src="image/apple_pay.svg" alt="Apple Pay" height="30" width="50">
                </a>
                <a href="https://www.corvuspay.com/" target="_blank" rel="noopener noreferrer" aria-label="CorvusPay – {{ text_opens_new_window }}">
                    <img class="cards-img p4 hidden-xs" src="image/corvus-logo-i.svg" alt="CorvusPay" height="30" width="114">
                </a>
            </div>
            <div class="col-xs-12 text-center dryzen-footer-logistics" aria-label="{{ text_shipping_partner }}">
                <span>{{ text_shipping_partner }}</span>
                <a href="https://www.eurosender.com/" target="_blank" rel="noopener noreferrer" aria-label="Eurosender – {{ text_opens_new_window }}">
                    <img src="image/catalog/shipping/eurosender-logo.svg" alt="Eurosender" width="140" height="23">
                </a>
            </div>
            <div class="clearfix"></div>

        </div><!-- .row ends -->




    </div>
    <div class="continer-fluid">
        {% if basel_copyright %}
            <div class="footer-copyright">{{ basel_copyright }}</div>
        {% endif %}
    </div>

</div>


<link  href="catalog/view/javascript/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
<link href="catalog/view/theme/basel/js/lightgallery/css/lightgallery.css" rel="stylesheet" />
<script src="catalog/view/theme/basel/js/jquery.matchHeight.min.js"></script>
<script src="catalog/view/theme/basel/js/countdown.js"></script>
<script src="catalog/view/theme/basel/js/featherlight.js"></script>
{% if view_popup %}
    <!-- Popup -->
    <script>
        $(document).ready(function() {
            if ($(window).width() > {{ popup_width_limit }}) {
                setTimeout(function() {
                    $.featherlight({ajax: 'index.php?route=extension/basel/basel_features/basel_popup', variant:'popup-wrapper'});
                }, {{ popup_delay }});
            }
        });
    </script>
{% endif %}
{% if sticky_columns %}
    <!-- Sticky columns -->
    <script>
      $(function() {
        if ($(window).width() > 767) {
            $('#column-left, #column-right').theiaStickySidebar({containerSelector:$(this).closest('.row'),additionalMarginTop:{{ sticky_columns_offset }}});
        }
      });
    </script>
{% endif %}

</div><!-- .outer-container ends -->

<a href="#top" class="scroll-to-top top primary-bg-color" aria-label="{{ text_back_to_top }}" onclick="$('html, body').animate({scrollTop:0});"><img src="image/up.svg" class="ikona" width="18" height="10" alt="" aria-hidden="true"></a>
<button type="button" class="gk-cookie-fab" data-cookie-consent-trigger aria-label="{{ text_cookie_settings }}" title="{{ text_cookie_settings }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5Z"/><path d="M8.5 8.5h.01M16 15.5h.01M12 12h.01M11 17h.01M7 14h.01"/></svg></button>
<div id="featherlight-holder"></div>
<script>
(function(){
  function loadCookieConsent(){
    if(window.gkCookieConsentLoading){return;}
    window.gkCookieConsentLoading=true;
    var core=document.createElement('script');
    core.src='catalog/view/javascript/cookieconsent/cookieconsent.umd.js?v=3.1';
    core.onload=function(){
      var config=document.createElement('script');
      config.src='catalog/view/javascript/cookieconsent/dryzen-consent.js?v=1.0';
      document.head.appendChild(config);
    };
    document.head.appendChild(core);
  }
  if('requestAnimationFrame' in window){requestAnimationFrame(function(){setTimeout(loadCookieConsent,100);});}
  else{setTimeout(loadCookieConsent,100);}
}());
</script>
</body></html>
