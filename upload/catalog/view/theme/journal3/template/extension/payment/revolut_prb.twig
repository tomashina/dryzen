{% if not error %}
<script src="catalog/view/javascript/revolut_helper.js" id="revolut-prb-js"></script>
<script src="https://{{ js_domain_source }}.revolut.com/embed.js" id="revolut-core-js"></script>
<style>
#revolut-payment-request-overlay {
  position: fixed;
  display: none;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0,0,0,0.5);
  z-index: 99999;
  cursor: pointer;
}

#revolut-payment-request-overlay img {
  width: 25px;
  position: absolute;
  top: 50%;
  left: 50%;
}
</style>
<div style="padding:30px">
  <div id="revolut-payment-request-overlay"><img src=""></div>
  <h3 id="revolut-prb-tittle">Apple Pay / Google Pay</h3>
  <div id="revolut-prb-field"></div>
  <div id="revolut-prb-error" class="text-danger text-center"></div>
</div>

<script src="catalog/view/javascript/revolut_prb.js" id="revolut-prb-js"></script>

{% else %}
<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error }}</div>
{% endif %}
