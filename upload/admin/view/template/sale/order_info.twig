  $(document).delegate('#button-boxnow-create, #button-boxnow-email, #button-boxnow-label-email', 'click', function() {
	var button = $(this);

	$.ajax({
	  url: button.data('url'),
	  dataType: 'json',
	  beforeSend: function() {
		button.button('loading');
	  },
	  complete: function() {
		button.button('reset');
	  },
	  success: function(json) {
		$('#boxnow-shipment .boxnow-alert').remove();

		if (json['error']) {
		  $('#boxnow-shipment .panel-body').prepend('<div class="alert alert-danger boxnow-alert"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + '</div>');
		  return;
		}

		if (json['warning']) {
		  $('#boxnow-shipment .panel-body').prepend('<div class="alert alert-warning boxnow-alert"><i class="fa fa-exclamation-triangle"></i> ' + json['warning'] + '</div>');
		}

		if (json['success']) {
		  $('#boxnow-shipment .panel-body').prepend('<div class="alert alert-success boxnow-alert"><i class="fa fa-check-circle"></i> ' + json['success'] + '</div>');
		  window.setTimeout(function() { window.location.reload(); }, 700);
		}
	  },
	  error: function(xhr, ajaxOptions, thrownError) {
		alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
	  }
	});
  });

  function showEurosenderAlert(level, message) {
	var icon = level === 'success' ? 'fa-check-circle' : (level === 'warning' ? 'fa-exclamation-triangle' : 'fa-exclamation-circle');
	var alert = $('<div>', {'class': 'alert alert-' + level + ' eurosender-alert'});

	$('<i>', {'class': 'fa ' + icon}).appendTo(alert);
	alert.append(document.createTextNode(' '));
	$('<span>').text(message).appendTo(alert);
	alert.prependTo('#eurosender-shipment .panel-body');
  }

  $(document).delegate('#button-eurosender-refresh', 'click', function() {
	var button = $(this);

	$.ajax({
	  url: button.data('url'),
	  type: 'post',
	  dataType: 'json',
	  beforeSend: function() {
		button.button('loading');
	  },
	  complete: function() {
		button.button('reset');
	  },
	  success: function(json) {
		$('#eurosender-shipment .eurosender-alert').remove();

		if (json['error']) {
		  showEurosenderAlert('danger', json['error']);
		  return;
		}

		if (json['success']) {
		  showEurosenderAlert('success', json['success']);
		  window.setTimeout(function() { window.location.reload(); }, 700);
		}
	  },
	  error: function(xhr, ajaxOptions, thrownError) {
		showEurosenderAlert('danger', thrownError + "\r\n" + xhr.statusText);
	  }
	});
  });

  $(document).delegate('#button-eurosender-create', 'click', function() {
	var button = $(this);

	$.ajax({
	  url: button.data('preview-url'),
	  type: 'post',
	  dataType: 'json',
	  beforeSend: function() {
		button.button('loading');
		$('#eurosender-shipment .eurosender-alert').remove();
	  },
	  success: function(json) {
		if (json['error']) {
		  showEurosenderAlert('danger', json['error']);
		  button.button('reset');
		  return;
		}

		if (!json['confirmation_token'] || !json['confirmation']) {
		  showEurosenderAlert('danger', button.data('preview-error'));
		  button.button('reset');
		  return;
		}

		if (!window.confirm(json['confirmation'])) {
		  button.button('reset');
		  return;
		}

		$.ajax({
		  url: button.data('create-url'),
		  type: 'post',
		  data: {confirmation_token: json['confirmation_token']},
		  dataType: 'json',
		  complete: function() {
			button.button('reset');
		  },
		  success: function(result) {
			$('#eurosender-shipment .eurosender-alert').remove();

			if (result['error']) {
			  showEurosenderAlert('danger', result['error']);
			  return;
			}

			if (result['warning']) {
			  showEurosenderAlert('warning', result['warning']);
			}

			if (result['success']) {
			  showEurosenderAlert('success', result['success']);
			  window.setTimeout(function() { window.location.reload(); }, result['warning'] ? 1800 : 700);
			}
		  },
		  error: function(xhr, ajaxOptions, thrownError) {
			showEurosenderAlert('danger', thrownError + "\r\n" + xhr.statusText);
		  }
		});
	  },
	  error: function(xhr, ajaxOptions, thrownError) {
		showEurosenderAlert('danger', thrownError + "\r\n" + xhr.statusText);
		button.button('reset');
	  }
	});
  });

   function showSendInvoiceNotification(level, message) {
          var icon = level === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle';
          var alert = $('<div>', {
              'class': 'alert alert-' + level + ' alert-dismissible',
              'role': 'alert'
          });

          $('<button>', {
              'type': 'button',
              'class': 'close',
              'data-dismiss': 'alert',
              'aria-label': 'Zatvori'
          }).html('&times;').appendTo(alert);

          $('<i>', {'class': 'fa ' + icon}).appendTo(alert);
          alert.append(document.createTextNode(' ' + message));

          $('#send-invoice-notification').empty().append(alert);
      }

   function sendInvoice() {
          var button = $('#button-send-invoice');
          var completedSuccessfully = false;

          if (button.prop('disabled')) {
              return;
          }

          $.ajax({
              url: 'index.php?route=sale/order/sendOrder&user_token={{ user_token }}&order_id={{ order_id }}',
              dataType: 'json',
              beforeSend: function() {
                  $('#send-invoice-notification').empty();
                  button.tooltip('hide');
                  button.button('loading').prop('disabled', true);
              },
              complete: function() {
                  button.button('reset').prop('disabled', completedSuccessfully);

                  if (completedSuccessfully) {
                      button.html("<i class='fa fa-check fa-fw'></i> e-Računi račun kreiran");
                  }
              },
              success: function(json) {
                  var status = parseInt(json.status, 10);
                  var message = json.message || (status === 200 ? 'Račun je uspješno kreiran.' : 'Kreiranje računa nije uspjelo.');

                  completedSuccessfully = status === 200;
                  showSendInvoiceNotification(status === 200 ? 'success' : 'danger', message);
              },
              error: function(xhr, ajaxOptions, thrownError) {
                  var message = 'Došlo je do greške u komunikaciji sa serverom.';

                  if (xhr.responseJSON && xhr.responseJSON.message) {
                      message = xhr.responseJSON.message;
                  } else if (thrownError) {
                      message += ' ' + thrownError;
                  }

                  showSendInvoiceNotification('danger', message);
              }
          });
      }

