{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-shipping" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ text_pricing_notice }}</div>
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-shipping" class="form-horizontal">
          <div class="form-group{% if error_default_size %} has-error{% endif %}">
            <label class="col-sm-2 control-label" for="input-default-size"><span data-toggle="tooltip" title="{{ help_default_size }}">{{ entry_default_size }}</span></label>
            <div class="col-sm-10">
              <select name="shipping_glspaketomat_default_size" id="input-default-size" class="form-control">
                {% for package_size in package_sizes %}
                <option value="{{ package_size.code }}"{% if package_size.code == shipping_glspaketomat_default_size %} selected="selected"{% endif %}>{{ package_size.code }}</option>
                {% endfor %}
              </select>
              {% if error_default_size %}<div class="text-danger">{{ error_default_size }}</div>{% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_cost }}">{{ entry_costs }}</span></label>
            <div class="col-sm-10">
              <div class="table-responsive">
                <table class="table table-bordered table-hover">
                  <thead>
                    <tr>
                      <th>{{ column_size }}</th>
                      <th>{{ column_cost }}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for package_size in package_sizes %}
                    <tr{% if error_costs[package_size.key] %} class="danger"{% endif %}>
                      <td>{{ package_size.code }}</td>
                      <td>
                        <input type="text" inputmode="decimal" name="{{ package_size.field }}" value="{{ package_size.cost }}" id="input-cost-{{ package_size.key }}" class="form-control" />
                        {% if error_costs[package_size.key] %}<div class="text-danger">{{ error_costs[package_size.key] }}</div>{% endif %}
                      </td>
                    </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-tax-class"><span data-toggle="tooltip" title="{{ help_tax_class }}">{{ entry_tax_class }}</span></label>
            <div class="col-sm-10">
              <select name="shipping_glspaketomat_tax_class_id" id="input-tax-class" class="form-control">
                <option value="0">{{ text_none }}</option>
                {% for tax_class in tax_classes %}
                <option value="{{ tax_class.tax_class_id }}"{% if tax_class.tax_class_id == shipping_glspaketomat_tax_class_id %} selected="selected"{% endif %}>{{ tax_class.title }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-geo-zone">{{ entry_geo_zone }}</label>
            <div class="col-sm-10">
              <select name="shipping_glspaketomat_geo_zone_id" id="input-geo-zone" class="form-control">
                <option value="0">{{ text_all_zones }}</option>
                {% for geo_zone in geo_zones %}
                <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == shipping_glspaketomat_geo_zone_id %} selected="selected"{% endif %}>{{ geo_zone.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="shipping_glspaketomat_status" id="input-status" class="form-control">
                {% if shipping_glspaketomat_status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group{% if error_sort_order %} has-error{% endif %}">
            <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="number" min="0" step="1" name="shipping_glspaketomat_sort_order" value="{{ shipping_glspaketomat_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
              {% if error_sort_order %}<div class="text-danger">{{ error_sort_order }}</div>{% endif %}
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
