{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-shipping" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-shipping" class="form-horizontal">
          <fieldset>
            <legend>{{ text_api_settings }}</legend>
            {% if api_key_configured %}
            <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ text_api_key_ready }}</div>
            {% else %}
            <div class="alert alert-warning"><i class="fa fa-exclamation-triangle"></i> {{ text_api_key_missing }}</div>
            {% endif %}
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-environment"><span data-toggle="tooltip" title="{{ help_environment }}">{{ entry_environment }}</span></label>
              <div class="col-sm-10">
                <select name="shipping_eurosender_environment" id="input-environment" class="form-control">
                  <option value="sandbox"{% if shipping_eurosender_environment == 'sandbox' %} selected="selected"{% endif %}>{{ text_sandbox }}</option>
                  <option value="production"{% if shipping_eurosender_environment == 'production' %} selected="selected"{% endif %}>{{ text_production }}</option>
                </select>
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>{{ text_service_settings }}</legend>
            <div class="form-group required">
              <label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_service_types }}">{{ entry_service_types }}</span></label>
              <div class="col-sm-10">
                {% for service_code, service_name in service_types %}
                <div class="checkbox">
                  <label><input type="checkbox" name="shipping_eurosender_service_types[]" value="{{ service_code|escape }}"{% if service_code in shipping_eurosender_service_types %} checked="checked"{% endif %} /> {{ service_name|escape }}</label>
                </div>
                {% endfor %}
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-payment-method">{{ entry_payment_method }}</label>
              <div class="col-sm-10">
                <select name="shipping_eurosender_payment_method" id="input-payment-method" class="form-control">
                  <option value="credit"{% if shipping_eurosender_payment_method == 'credit' %} selected="selected"{% endif %}>{{ text_credit }}</option>
                  <option value="deferred"{% if shipping_eurosender_payment_method == 'deferred' %} selected="selected"{% endif %}>{{ text_deferred }}</option>
                </select>
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>{{ text_package_settings }}</legend>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-length">{{ entry_length }}</label>
              <div class="col-sm-10"><input type="number" min="1" step="1" name="shipping_eurosender_length" value="{{ shipping_eurosender_length|escape }}" id="input-length" class="form-control" /></div>
            </div>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-width">{{ entry_width }}</label>
              <div class="col-sm-10"><input type="number" min="1" step="1" name="shipping_eurosender_width" value="{{ shipping_eurosender_width|escape }}" id="input-width" class="form-control" /></div>
            </div>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-height">{{ entry_height }}</label>
              <div class="col-sm-10"><input type="number" min="1" step="1" name="shipping_eurosender_height" value="{{ shipping_eurosender_height|escape }}" id="input-height" class="form-control" /></div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-packaging-weight">{{ entry_packaging_weight }}</label>
              <div class="col-sm-10"><input type="number" min="0" step="0.01" name="shipping_eurosender_packaging_weight" value="{{ shipping_eurosender_packaging_weight|escape }}" id="input-packaging-weight" class="form-control" /></div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-fallback-item-weight"><span data-toggle="tooltip" title="{{ help_fallback_item_weight }}">{{ entry_fallback_item_weight }}</span></label>
              <div class="col-sm-10"><input type="number" min="0" step="0.01" name="shipping_eurosender_fallback_item_weight" value="{{ shipping_eurosender_fallback_item_weight|escape }}" id="input-fallback-item-weight" class="form-control" /></div>
            </div>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-minimum-weight"><span data-toggle="tooltip" title="{{ help_minimum_weight }}">{{ entry_minimum_weight }}</span></label>
              <div class="col-sm-10"><input type="number" min="0.01" step="0.01" name="shipping_eurosender_minimum_weight" value="{{ shipping_eurosender_minimum_weight|escape }}" id="input-minimum-weight" class="form-control" /></div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-content"><span data-toggle="tooltip" title="{{ help_content }}">{{ entry_content }}</span></label>
              <div class="col-sm-10"><input type="text" name="shipping_eurosender_content" value="{{ shipping_eurosender_content|escape }}" id="input-content" class="form-control" /></div>
            </div>
          </fieldset>

          <fieldset>
            <legend>{{ text_pricing_settings }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-markup-type"><span data-toggle="tooltip" title="{{ help_markup }}">{{ entry_markup_type }}</span></label>
              <div class="col-sm-10">
                <select name="shipping_eurosender_markup_type" id="input-markup-type" class="form-control">
                  <option value="fixed"{% if shipping_eurosender_markup_type == 'fixed' %} selected="selected"{% endif %}>{{ text_fixed }}</option>
                  <option value="percent"{% if shipping_eurosender_markup_type == 'percent' %} selected="selected"{% endif %}>{{ text_percent }}</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-markup-value">{{ entry_markup_value }}</label>
              <div class="col-sm-10"><input type="number" min="0" step="0.01" name="shipping_eurosender_markup_value" value="{{ shipping_eurosender_markup_value|escape }}" id="input-markup-value" class="form-control" /></div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-fallback-rate"><span data-toggle="tooltip" title="{{ help_fallback_rate }}">{{ entry_fallback_rate }}</span></label>
              <div class="col-sm-10"><input type="number" min="0" step="0.01" name="shipping_eurosender_fallback_rate" value="{{ shipping_eurosender_fallback_rate|escape }}" placeholder="{{ text_none|escape }}" id="input-fallback-rate" class="form-control" /></div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-tax-class"><span data-toggle="tooltip" title="{{ help_tax_class }}">{{ entry_tax_class }}</span></label>
              <div class="col-sm-10">
                <select name="shipping_eurosender_tax_class_id" id="input-tax-class" class="form-control">
                  <option value="0">{{ text_none }}</option>
                  {% for tax_class in tax_classes %}
                  <option value="{{ tax_class.tax_class_id }}"{% if tax_class.tax_class_id == shipping_eurosender_tax_class_id %} selected="selected"{% endif %}>{{ tax_class.title }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>{{ text_origin_settings }}</legend>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-origin-name">{{ entry_origin_name }}</label>
              <div class="col-sm-10"><input type="text" name="shipping_eurosender_origin_name" value="{{ shipping_eurosender_origin_name|escape }}" id="input-origin-name" class="form-control" /></div>
            </div>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-origin-email">{{ entry_origin_email }}</label>
              <div class="col-sm-10"><input type="email" name="shipping_eurosender_origin_email" value="{{ shipping_eurosender_origin_email|escape }}" id="input-origin-email" class="form-control" /></div>
            </div>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-origin-phone">{{ entry_origin_phone }}</label>
              <div class="col-sm-10"><input type="text" name="shipping_eurosender_origin_phone" value="{{ shipping_eurosender_origin_phone|escape }}" id="input-origin-phone" class="form-control" /></div>
            </div>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-origin-address-1">{{ entry_origin_address_1 }}</label>
              <div class="col-sm-10"><input type="text" name="shipping_eurosender_origin_address_1" value="{{ shipping_eurosender_origin_address_1|escape }}" id="input-origin-address-1" class="form-control" /></div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-origin-address-2">{{ entry_origin_address_2 }}</label>
              <div class="col-sm-10"><input type="text" name="shipping_eurosender_origin_address_2" value="{{ shipping_eurosender_origin_address_2|escape }}" id="input-origin-address-2" class="form-control" /></div>
            </div>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-origin-city">{{ entry_origin_city }}</label>
              <div class="col-sm-10"><input type="text" name="shipping_eurosender_origin_city" value="{{ shipping_eurosender_origin_city|escape }}" id="input-origin-city" class="form-control" /></div>
            </div>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-origin-postcode">{{ entry_origin_postcode }}</label>
              <div class="col-sm-10"><input type="text" name="shipping_eurosender_origin_postcode" value="{{ shipping_eurosender_origin_postcode|escape }}" id="input-origin-postcode" class="form-control" /></div>
            </div>
            <div class="form-group required">
              <label class="col-sm-2 control-label" for="input-origin-country-code">{{ entry_origin_country_code }}</label>
              <div class="col-sm-10"><input type="text" maxlength="2" name="shipping_eurosender_origin_country_code" value="{{ shipping_eurosender_origin_country_code|escape }}" id="input-origin-country-code" class="form-control text-uppercase" /></div>
            </div>
          </fieldset>

          <fieldset>
            <legend>{{ text_general_settings }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-geo-zone">{{ entry_geo_zone }}</label>
              <div class="col-sm-10">
                <select name="shipping_eurosender_geo_zone_id" id="input-geo-zone" class="form-control">
                  <option value="0">{{ text_all_zones }}</option>
                  {% for geo_zone in geo_zones %}
                  <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == shipping_eurosender_geo_zone_id %} selected="selected"{% endif %}>{{ geo_zone.name }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
              <div class="col-sm-10">
                <select name="shipping_eurosender_status" id="input-status" class="form-control">
                  <option value="1"{% if shipping_eurosender_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                  <option value="0"{% if not shipping_eurosender_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
              <div class="col-sm-10"><input type="number" min="0" step="1" name="shipping_eurosender_sort_order" value="{{ shipping_eurosender_sort_order|escape }}" id="input-sort-order" class="form-control" /></div>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
